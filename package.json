{
	"name": "cad-nauseam",
	"version": "1.0.3",
	"private": true,
	"description": "Web-based implementation of Wolfram's one-dimensional cellular automata.",
	"keywords": [
		"wolfram",
		"cellular-automata"
	],
	"homepage": "https://frontiernerds.com/cad-nauseam",
	"bugs": "https://github.com/kitschpatrol/cad-nauseam/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/cad-nauseam.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": [
		"./dist/cad-nauseam.js"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/cad-nauseam.d.ts",
			"default": "./dist/cad-nauseam.js"
		}
	},
	"main": "./dist/cad-nauseam.js",
	"module": "./dist/cad-nauseam.js",
	"types": "./dist/cad-nauseam.d.ts",
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "vite build --config vite-library.config.ts && vite build && tsx ./scripts/version.ts > ./site/version.json",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "poptab && vite",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"preview": "pnpm build && poptab && vite preview",
		"release": "bumpp --commit 'Release: %s' && pnpm build && wrangler deploy",
		"test": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.1",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@types/node": "~24.13.6",
		"bumpp": "^12.3.0",
		"happy-dom": "^20.14.6",
		"lit": "^3.3.3",
		"poptab": "^1.2.2",
		"shx": "^0.4.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"peerDependencies": {
		"lit": "^3.0.0"
	},
	"packageManager": "pnpm@12.15.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	}
}
